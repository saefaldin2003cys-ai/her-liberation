# ---------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and never ships to the browser.
# ---------------------------------------------------------------

# MongoDB Atlas connection string (free M0 cluster is enough).
# Atlas > Database > Connect > Drivers.
MONGODB_URI=
MONGODB_DB=herliberation

# Signs the admin session cookie. Must be 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# bcrypt hash of the admin password — never the password itself.
# Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR-PASSWORD', 12))"
ADMIN_PASSWORD_HASH=

# Cloudinary, for article images. Free tier is plenty.
# Dashboard > Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site URL, used for canonical links and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
